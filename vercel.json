{
 "cleanUrls": true,
 "rewrites": [
  {
   "source": "/apps/:id",
   "destination": "/apps__:id.html"
  },
  {
   "source": "/posters/en/:f",
   "destination": "/posters__en__:f"
  },
  {
   "source": "/icons/:f",
   "destination": "/icons__:f"
  },
  {
   "source": "/media/:f",
   "destination": "/media__:f"
  },
  {
   "source": "/posters/:f",
   "destination": "/posters__:f"
  },
  {
   "source": "/shots/:f",
   "destination": "/shots__:f"
  }
 ],
 "headers": [
  {
   "source": "/(.*)\\.(png|jpg|webp)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000, immutable"
    }
   ]
  }
 ]
}